{
  "name": "kg_tool",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:extension": "npm run build && powershell -NoProfile -Command \"if (Test-Path dist/KG-Studio-Extension-v2.5.0.zip) { Remove-Item dist/KG-Studio-Extension-v2.5.0.zip }; Compress-Archive -Path dist/* -DestinationPath public/KG-Studio-Extension-v2.5.0.zip -Force; Copy-Item public/KG-Studio-Extension-v2.5.0.zip dist/KG-Studio-Extension-v2.5.0.zip -Force\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jspdf": "^1.3.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^5.4.11"
  }
